{
  "manifest_version": 3,
  "name": "Ares Browser Analysis",
  "version": "1.1",
  "description": "High-fidelity network auditing for Ares with reliable payload capture.",
  "permissions": [
    "webRequest",
    "tabs",
    "activeTab",
    "alarms",
    "webNavigation",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["main_world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {}
}
